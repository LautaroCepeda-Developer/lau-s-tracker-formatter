---
interface Props {
    currentLanguage: "es" | "en";
}

const { currentLanguage } = Astro.props;

const spanishURL = currentLanguage === "es" ? "/" : "/";
const englishURL = currentLanguage === "en" ? "/en/" : "/en/";
---

<nav class="language-selector" aria-label="Language">
    <a
        href={spanishURL}
        class={currentLanguage === "es" ? "active" : ""}
        hreflang="es"
    >
        🇪🇸 ES
    </a>

    <span>|</span>

    <a
        href={englishURL}
        class={currentLanguage === "en" ? "active" : ""}
        hreflang="en"
    >
        🇬🇧 EN
    </a>
</nav>

<style>
    .language-selector {
        display: flex;
        align-items: center;
        gap: 7px;
        font-size: 12px;
    }

    .language-selector a {
        color: #727b8f;
        text-decoration: none;
        transition: color 0.15s;
    }

    .language-selector a:hover {
        color: #e5e7eb;
    }

    .language-selector a.active {
        color: #e5e7eb;
        font-weight: 600;
    }

    .language-selector span {
        color: #3d4350;
    }
</style>