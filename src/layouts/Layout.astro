---
import type { SiteTranslations } from "../i18n/i18n.types";

interface Props {
    translations: SiteTranslations;
    canonicalURL: URL;
    alternateURL: URL;
    noIndex?: boolean;
}

const {
    translations,
    canonicalURL,
    alternateURL,
    noIndex = false,
} = Astro.props;

const isSpanish = translations.lang === "es";
const alternateLang = isSpanish ? "en" : "es";
---

<!doctype html>
<html lang={translations.lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />

        <title>{translations.title}</title>
        <meta
            name="description"
            content={translations.description}
        />

        {!noIndex && (
        <link rel="canonical" href={canonicalURL} />

        <link
            rel="alternate"
            hreflang={translations.lang}
            href={canonicalURL}
        />

        <link
            rel="alternate"
            hreflang={alternateLang}
            href={alternateURL}
        />

        <link
            rel="alternate"
            hreflang="x-default"
            href={isSpanish ? canonicalURL : alternateURL}
        />
        
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Lau's Tracker Formatter"/>
        <meta property="og:title" content={translations.title} />
        <meta property="og:description" content={translations.description}/>
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:locale" content={translations.lang === "es" ? "es_AR" : "en_US"} />
        <meta property="og:locale:alternate" content={translations.lang === "es" ? "en_US" : "es_AR"}/>
        <meta property="og:image" content={new URL("/og-image.png", Astro.site)}/>
        <meta property="og:image:alt" content={translations.title}/>

        <meta name="twitter:card" content="summary_large_image"/>
        <meta name="twitter:title" content={translations.title}/>
        <meta name="twitter:description" content={translations.description}/>
        <meta name="twitter:image" content={new URL("/og-image.png", Astro.site)}/>

        <meta name="robots" content="noindex, nofollow"/>)}
        <slot name="head" />
    </head>

    <body>
        <slot />

        <style is:global>
            *,
            *::before,
            *::after {
                box-sizing: border-box;
            }

            html {
                background: #0f1117;
            }

            body {
                margin: 0;
                min-width: 320px;
                color: #e5e7eb;
                background:
                    radial-gradient(
                        circle at top,
                        #1a2030 0%,
                        #0f1117 45%
                    );
                font-family:
                    Inter,
                    ui-sans-serif,
                    system-ui,
                    -apple-system,
                    BlinkMacSystemFont,
                    "Segoe UI",
                    sans-serif;
            }

            button,
            textarea {
                font: inherit;
            }
        </style>
    </body>
</html>